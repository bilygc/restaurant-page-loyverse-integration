# Copiar a .env.local y completar. Solo valores PUBLICOS (NEXT_PUBLIC_*).
# NUNCA colocar aqui la service role key de Supabase ni la secret key de Stripe.

# URL base de la API (NestJS / Render)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Supabase (valores publicos)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
