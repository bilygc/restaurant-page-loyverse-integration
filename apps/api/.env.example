# apps/api — environment variable reference (server-side secrets only, POC §9).
# Copy to apps/api/.env locally. Never commit real values; validated at boot by
# the config module. NAMES + SAFE DEFAULTS only — no real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# mock must NOT be used in production (boot guard, plan.md §9.5).
PAYMENT_MODE=mock
WEB_APP_ORIGIN=http://localhost:3001

# --- Supabase (Postgres, service role; API is the only DB client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Loyverse (POS / sales register) ---
# NAMING RESOLVED: LOYVERSE_API_TOKEN (brief) -> LOYVERSE_ACCESS_TOKEN (canonical).
# LOYVERSE_API_TOKEN is a DEPRECATED ALIAS and is NOT read by the application.
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
LOYVERSE_STORE_ID=
LOYVERSE_PAYMENT_TYPE_ID=
# Unguessable token for the unsigned receipts.update webhook, via ?token= OR
# the X-Webhook-Token header:
#   POST /loyverse/webhooks/receipts?token=<LOYVERSE_WEBHOOK_TOKEN>
#   POST /loyverse/webhooks/receipts  -H 'X-Webhook-Token: <...>'
# H3 raw-body evidence logging is development-only (never in production).
LOYVERSE_WEBHOOK_TOKEN=
# NOT used: LOYVERSE_WEBHOOK_SECRET (webhook is unsigned).

# --- Outbox retries (H6 / flow D) ---
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20

# --- Poller + rate-limit awareness (300/300s) ---
LOYVERSE_POLL_INTERVAL_MS=15000
LOYVERSE_POLL_LOOKBACK_MINUTES=60
LOYVERSE_RATE_LIMIT=300
LOYVERSE_RATE_WINDOW_MS=300000

# --- Kitchen screen (X-Kitchen-Pin header; KITCHEN_PIN alias accepted) ---
KITCHEN_PIN=

# --- NOT used in the POC: no Stripe, no Resend ---
