# apps/api — environment variable reference (server-side secrets only).
# Copy to apps/api/.env locally. Never commit real values; secrets come from
# the environment only and are validated at boot by the config module.

# --- Stripe (payments + webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Supabase (Postgres, service role) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Loyverse (POS / KDS integration) ---
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE_URL=

# --- Resend (order emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Runtime ---
# PAYMENT_MODE: mock | live. mock must NOT be used in production (plan.md §9.5).
PAYMENT_MODE=mock
PORT=3000
NODE_ENV=development
