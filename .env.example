# restaurant-platform — environment variable reference.
# Copy the variables you need into a local .env (never commit real values).
# Secrets are read from the environment only; see README.md.

# --- Stripe (payments + webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Supabase (Postgres) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Loyverse (POS / KDS integration) ---
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE_URL=

# --- Resend (order emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Runtime ---
# PAYMENT_MODE: mock | live. The API must refuse to boot with mock in production (plan.md §9.5).
PAYMENT_MODE=mock
PORT=3000
NODE_ENV=development
