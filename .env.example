# restaurant-platform — environment variable reference (POC, plan.md §9).
# Copy the variables you need into a local .env (never commit real values).
# Secrets are read from the environment only; validated at boot by the API
# config module. This file lists NAMES + SAFE DEFAULTS only — no real secrets.

# --- Runtime ---
NODE_ENV=development
PORT=3000
# PAYMENT_MODE: mock | live. The API REFUSES TO BOOT with mock in production
# (plan.md §9.5). The POC has no live gateway; use mock outside production.
PAYMENT_MODE=mock
# CORS: the web app's origin (the only origin allowed to call the API).
WEB_APP_ORIGIN=http://localhost:3001

# --- Supabase (Postgres) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local POC testing with permissive RLS policies only (NOT used by the API).
SUPABASE_ANON_KEY=

# --- Loyverse (POS / sales register) ---
# NAMING RESOLVED: the brief's "LOYVERSE_API_TOKEN" is standardized to the
# name already used in the repo + migration: LOYVERSE_ACCESS_TOKEN (a Loyverse
# Personal Access Token). LOYVERSE_API_TOKEN is a DEPRECATED ALIAS, not read.
LOYVERSE_ACCESS_TOKEN=
LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
# Required to POST /receipts (H1):
LOYVERSE_STORE_ID=
LOYVERSE_PAYMENT_TYPE_ID=
# Unguessable token protecting the receipts.update webhook. The webhook is
# UNSIGNED (no HMAC), so per the ADR the secret is supplied via ?token= OR the
# X-Webhook-Token header (constant-time comparison):
#   POST /loyverse/webhooks/receipts?token=<LOYVERSE_WEBHOOK_TOKEN>
#   POST /loyverse/webhooks/receipts  -H 'X-Webhook-Token: <...>'
# Raw payloads are logged for H3 evidence ONLY in NODE_ENV=development (test
# account, no real PII). Never in production.
LOYVERSE_WEBHOOK_TOKEN=
# NOT used: LOYVERSE_WEBHOOK_SECRET (webhook is unsigned; URL token instead).

# --- Outbox (create_receipt retries, H6 / flow D) ---
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BASE_BACKOFF_MS=1000
OUTBOX_MAX_BACKOFF_MS=60000
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20

# --- Loyverse poller + rate-limit awareness (300 requests / 300 s) ---
LOYVERSE_POLL_INTERVAL_MS=15000
LOYVERSE_POLL_LOOKBACK_MINUTES=60
LOYVERSE_RATE_LIMIT=300
LOYVERSE_RATE_WINDOW_MS=300000

# --- Kitchen screen (plan.md §9.7) ---
# Simple PIN sent in the X-Kitchen-Pin header (legacy KITCHEN_PIN alias also
# accepted). POC-only, not full auth.
KITCHEN_PIN=

# --- NOT used in the POC (plan.md §9.1 / §9.5): no Stripe, no Resend ---
# STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PUBLISHABLE_KEY
# RESEND_API_KEY, RESEND_FROM_EMAIL
